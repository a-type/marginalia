{
  "lexicon": 1,
  "id": "com.apostilbible.annotation",
  "description": "Defines how users make comments on one or more verses.",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "description": "An individual comment on a group of verses",
      "record": {
        "type": "object",
        "required": ["verses", "comment", "createdAt"],
        "properties": {
          "commentaryId": {
            "type": "ref",
            "ref": "com.apostilbible.commentary",
            "description": "References a commentary (a named collection of annotations) if one is associated"
          },
          "verses": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#verseRef"
            },
            "description": "The IDs of the verses this comment is on"
          },
          "comment": {
            "type": "string",
            "description": "Supports markdown with extensions."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Client-side creation time"
          }
        }
      }
    },
    "verseRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  }
}
