{
  "lexicon": 1,
  "id": "com.marginalia.follow",
  "description": "Defines a user's follow of another Marginalia account.",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "description": "A follow relationship. The record author is the follower.",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
