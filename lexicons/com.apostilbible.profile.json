{
  "lexicon": 1,
  "id": "com.apsotilbible.profile",
  "description": "Defines a Apostil user's public profile.",
  "defs": {
    "main": {
      "key": "literal:self",
      "type": "record",
      "description": "The profile for a Apostil account.",
      "record": {
        "type": "object",
        "required": ["handle", "createdAt"],
        "properties": {
          "handle": {
            "type": "string",
            "format": "handle"
          },
          "displayName": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
