# Public origin of the TanStack Start app. Keep this to the origin, with no path.
APP_URL=http://127.0.0.1:7654

# Production hostname used by Caddy. Change this to match APP_URL in production.
APP_DOMAIN=localhost

# Public HappyView API client key (hvc_...). This is intentionally browser-visible.
VITE_HAPPYVIEW_CLIENT_KEY=

# HappyView container settings.
HAPPYVIEW_VERSION=2.15.0
HAPPYVIEW_UPSTREAM=http://127.0.0.1:3001
HAPPYVIEW_BASE_URL=http://127.0.0.1:3001/api
HAPPYVIEW_DATABASE_URL=sqlite:///data/happyview.sqlite?mode=rwc
HAPPYVIEW_SESSION_SECRET=
HAPPYVIEW_TOKEN_ENCRYPTION_KEY=
HAPPYVIEW_ADMIN_KEY=
HAPPYVIEW_RUST_LOG=happyview=info,tower_http=info
