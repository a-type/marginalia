# Path to the SQLite database file. Defaults to ./marginalia.sqlite when unset.
DATABASE_PATH=./marginalia.sqlite

# Public origin used by ATProto OAuth. Use http://127.0.0.1:3000 locally.
APP_URL=http://127.0.0.1:3000

# At least 32 random characters. Generate one with: openssl rand -base64 32
SESSION_PASSWORD=

# Optional shared Tap admin password. When set, Tap sends it to the webhook via
# Basic auth and the app requires it on /api/tap/webhook.
TAP_ADMIN_PASSWORD=
