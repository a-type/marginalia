{
  "lexicon": 1,
  "id": "com.marginsbible.annotation.listMine",
  "description": "Lists the authenticated caller's annotations, newest first.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "records": {
              "type": "array",
              "items": { "type": "unknown" }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
