{
  "name": "margins",
  "private": true,
  "type": "module",
  "scripts": {
    "usfm:download": "node ./scripts/download-usfm.mjs",
    "happyview:provision": "dotenv -e .env -- node ./scripts/provision-happyview.mjs",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "prepare": "husky",
    "lexicons": "pnpm --filter @marginsbible/atproto lexicons && pnpm --filter @marginsbible/atproto exec lex build --lexicons ./lexicons --out ../../app/src/lexicons --clear",
    "free-ports": "pnpx kill-port 7654"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,html,json,jsonc,md,mdx}": "prettier --write"
  },
  "dependencies": {
    "@arbor-css/core": "catalog:"
  },
  "devDependencies": {
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "profano": "^0.3.0",
    "railway": "catalog:",
    "typescript": "catalog:",
    "@tanstack/eslint-config": "catalog:"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
